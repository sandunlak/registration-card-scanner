# Backend environment variables
# Copy this file to .env and fill in values as needed.
# All defaults work for local development without modification.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/db/app.db

# ── Image Storage ─────────────────────────────────────────────────────────────
IMAGES_DIR=./data/images

# ── Upload Limits ─────────────────────────────────────────────────────────────
# Maximum allowed upload size per image, in megabytes
MAX_UPLOAD_SIZE_MB=20
# Maximum decoded image pixels, regardless of compressed file size
MAX_IMAGE_PIXELS=40000000
# Maximum number of files accepted by one batch request
MAX_IMAGES_PER_BATCH=10
# Private local cache for OCR model weights; setup is an explicit command.
OCR_MODELS_DIR=./data/models/ocr
# Upper bound for manually selected handwriting line crops per OCR job.
OCR_MAX_HANDWRITING_REGIONS=20
# Comma-separated list of allowed MIME types
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ── Privacy / Retention ───────────────────────────────────────────────────────
# Number of days original card images are retained before becoming eligible
# for deletion by the housekeeping job.  Set to 0 to disable auto-deletion.
IMAGE_RETENTION_DAYS=90

# ── OCR ───────────────────────────────────────────────────────────────────────
# Minimum confidence score (0.0–1.0) below which a field is flagged for review
OCR_CONFIDENCE_THRESHOLD=0.75
OCR_MODELS_DIR=./data/models/ocr
OCR_MAX_HANDWRITING_REGIONS=20

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
